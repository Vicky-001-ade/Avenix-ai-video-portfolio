      (function () {
        function isWalletExtensionError(msg, stack, filename) {
          var text = ((msg || '') + ' ' + (stack || '') + ' ' + (filename || '')).toLowerCase();
          return (
            text.indexOf('metamask') !== -1 ||
            text.indexOf('inpage.js') !== -1 ||
            text.indexOf('chrome-extension://') !== -1 ||
            text.indexOf('moz-extension://') !== -1
          );
